node_modules/
.next/
out/
*.log
.env*.local
.DS_Store
next-env.d.ts

# Learner artifacts created during the course (system prompts, drafts, etc.)
# Keep the work/ folders themselves so fresh clones have them, but ignore contents.
module-*/work/*
!module-*/work/.gitkeep

# Learner-created Claude Code Skills from Module 2 onward.
# Each learner builds their own Skills during the course — don't commit them back.
.claude/skills/

# Learner-created Claude Code agents from Module 3 onward.
# Each learner builds their own (e.g. daily-briefing.md) — those get ignored.
# But Module 5 ships pre-built specialists + orchestrator so the lesson is
# coordination, not 4-file typing. Those specific files are exempt below.
.claude/agents/*
!.claude/agents/notes-specialist.md
!.claude/agents/calendar-specialist.md
!.claude/agents/followups-specialist.md
!.claude/agents/ea-orchestrator.md
